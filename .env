# Modo mock — omite llamadas al backend y usa datos de prueba (solo desarrollo)
NEXT_PUBLIC_USE_MOCKS=false

# URL base del backend / API Gateway del ecosistema
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# URLs de los frontends de cada microservicio
NEXT_PUBLIC_URL_MICROSERVICIO_CISTEM_VISION=http://localhost:3001

# URLs BACKEND de cada microservicio 
NEXT_PUBLIC_API_MICROSERVICIO_CISTEM_VISION=http://localhost:8081

# NEXT_PUBLIC_URL_MICROSERVICIO_<NOMBRE>=https://...

